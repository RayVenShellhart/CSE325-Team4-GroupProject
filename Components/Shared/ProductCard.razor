@using CSE325_Team4_GroupProject.Models
@inject CSE325_Team4_GroupProject.Services.CartService Cart
@inject NavigationManager Navigation

<div class="product-card" @onclick="NavigateToProduct">

    <img src="@Product.ImageUrl" alt="@Product.Name" />

    <div class="product-info">

        <h3>@Product.Name</h3>

        <p class="description">
            @Product.Description
        </p>

        <span class="price">
            ₦@Product.Price
        </span>

        <div class="rating">
            ⭐ @Product.Rating
        </div>

        <button type="button" class="add-to-cart" @onclick="AddToCart" @onclick:stopPropagation="true">
            @buttonText
        </button>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <p class="cart-status">@statusMessage</p>
        }

    </div>

</div>

<style>
    .product-card {
        background: white;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
        transition: transform .3s, box-shadow .3s;
        cursor: pointer;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 20px rgba(0, 0, 0, .15);
    }

    .product-card img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .product-info {
        padding: 15px;
    }

    .product-card h3 {
        margin: 0 0 5px;
        font-size: 18px;
    }

    .description {
        color: #7f8c8d;
        font-size: 14px;
        margin: 5px 0;
    }

    .price {
        color: #e74c3c;
        font-size: 20px;
        font-weight: bold;
        display: block;
    }

    .rating {
        color: #f1c40f;
        margin: 8px 0;
    }

    .add-to-cart {
        width: 100%;
        padding: 10px;
        border: none;
        border-radius: 5px;
        background: #2c3e50;
        color: white;
        cursor: pointer;
    }

    .add-to-cart:hover {
        background: #1a252f;
    }

    .cart-status {
        margin-top: 10px;
        color: green;
        font-size: 14px;
    }
</style>

@code {

    [Parameter]
    public Product Product { get; set; } = new();

    private string buttonText = "Add to Cart";
    private string? statusMessage;

    private void NavigateToProduct()
    {
        Navigation.NavigateTo($"/product/{Product.Id}");
    }

    private void AddToCart()
    {
        Cart.Add(Product);

        buttonText = "Added";

        statusMessage = $"{Product.Name} added to cart";

        StateHasChanged();
    }
}