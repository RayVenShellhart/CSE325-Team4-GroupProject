@page "/product/{Id:int}"

@using CSE325_Team4_GroupProject.Models
@inject CSE325_Team4_GroupProject.Services.ProductService ProductService
@inject CSE325_Team4_GroupProject.Services.CartService Cart
@inject NavigationManager Navigation

<PageTitle>ShopHub - @(product?.Name ?? "Product")</PageTitle>

@if (product == null)
{
    <div class="not-found">
        <p>😕 Sorry, this product does not exist.</p>
        <a class="btn btn-primary" href="/products">Browse products</a>
    </div>
}
else
{
    <nav class="breadcrumb">
        <a href="/">Home</a> <span>/</span>
        <a href="/products">Products</a> <span>/</span>
        <a href="@CategoryUrl">@product.Category</a> <span>/</span>
        <b>@product.Name</b>
    </nav>

    <div class="product-page">
        <div class="product-image">
            <img src="@product.ImageUrl" alt="@product.Name">
        </div>
        <div class="product-info">
            <span class="category-tag">@product.Category</span>
            <h1>@product.Name</h1>
            <div class="rating-line">
                <span class="stars">@Stars(product.Rating)</span>
                <span class="rating-value">@product.Rating</span>
            </div>
            <p class="price">₦@product.Price.ToString("0.00")</p>
            <p class="description-text">@product.Description</p>

            <div class="seller-box">
                <span>Sold by:</span>
                <b>@(product.SellerName ?? "ShopHub")</b>
            </div>

            <div class="actions">
                <button class="btn-add-cart" @onclick="AddToCart" disabled="@isAdding">
                    @(isAdding ? "Adding..." : (inCart ? "✓ Added to Cart" : "🛒 Add to Cart"))
                </button>
                <a class="btn-buy-now" href="/checkout">Buy Now</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <p class="cart-status">@statusMessage</p>
            }
        </div>
    </div>

    @if (relatedProducts.Any())
    {
        <section class="related">
            <h2>You may also like</h2>
            <div class="product-grid">
                @foreach (var related in relatedProducts)
                {
                    <ProductCard Product="related" />
                }
            </div>
        </section>
    }
}

<style>
    .breadcrumb {
        font-size: 14px;
        margin-bottom: 20px;
        color: #7f8c8d;
    }

    .breadcrumb a {
        color: #3498db;
        text-decoration: none;
    }

    .breadcrumb a:hover {
        text-decoration: underline;
    }

    .product-page {
        display: flex;
        gap: 40px;
        align-items: flex-start;
        padding: 30px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
    }

    .product-image {
        flex: 1;
        max-width: 420px;
    }

    .product-image img {
        width: 100%;
        max-height: 420px;
        object-fit: cover;
        border-radius: 10px;
    }

    .product-info {
        flex: 1;
    }

    .category-tag {
        display: inline-block;
        background: #ecf0f1;
        color: #2c3e50;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .product-info h1 {
        margin: 0 0 10px;
        font-size: 30px;
        color: #2c3e50;
    }

    .rating-line {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
    }

    .stars {
        color: #f1c40f;
        font-size: 17px;
    }

    .rating-value {
        color: #7f8c8d;
        font-size: 14px;
    }

    .price {
        font-size: 32px;
        font-weight: bold;
        color: #e74c3c;
        margin: 10px 0;
    }

    .description-text {
        color: #555;
        font-size: 16px;
        line-height: 1.6;
        margin: 15px 0;
    }

    .seller-box {
        background: #f8f9fa;
        padding: 12px 16px;
        border-radius: 8px;
        margin: 15px 0;
        font-size: 14px;
    }

    .seller-box span {
        color: #7f8c8d;
    }

    .actions {
        display: flex;
        gap: 15px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .btn-add-cart,
    .btn-buy-now {
        padding: 14px 32px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-add-cart {
        background: #2c3e50;
        color: white;
    }

    .btn-add-cart:hover:not(:disabled) {
        background: #1a252f;
        transform: translateY(-2px);
    }

    .btn-add-cart:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .btn-buy-now {
        background: #f1c40f;
        color: #2c3e50;
    }

    .btn-buy-now:hover {
        background: #f39c12;
        transform: translateY(-2px);
    }

    .cart-status {
        color: green;
        font-size: 14px;
        margin-top: 12px;
    }

    .related {
        margin-top: 50px;
    }

    .related h2 {
        font-size: 24px;
        color: #2c3e50;
        margin-bottom: 20px;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
    }

    .not-found {
        text-align: center;
        padding: 60px 20px;
    }

    .btn {
        padding: 10px 18px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: background 0.3s;
    }

    .btn-primary {
        background: #f1c40f;
        color: #2c3e50;
    }

    @@media (max-width: 800px) {
        .product-page {
            flex-direction: column;
        }

        .product-image {
            max-width: 100%;
        }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;
    private List<Product> relatedProducts = new();
    private bool isAdding;
    private bool inCart;
    private string? statusMessage;

    private string CategoryUrl => $"/category/{Uri.EscapeDataString(product?.Category ?? "")}";

    protected override async Task OnParametersSetAsync()
    {
        product = await ProductService.GetProductByIdAsync(Id);

        if (product != null)
        {
            await Cart.LoadCartAsync();
            inCart = Cart.Contains(product.Id);
            relatedProducts = await ProductService.GetRelatedProductsAsync(product);
        }
    }

    private async Task AddToCart()
    {
        if (product == null)
        {
            return;
        }

        isAdding = true;
        await Cart.Add(product);
        inCart = true;
        isAdding = false;
        statusMessage = $"{product.Name} added to your cart!";
        StateHasChanged();
    }

    private static string Stars(double rating)
    {
        var full = (int)Math.Round(rating);
        return new string('⭐', Math.Clamp(full, 1, 5));
    }
}
