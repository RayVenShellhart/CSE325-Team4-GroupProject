@page "/product/{Id:int}"
@using CSE325_Team4_GroupProject.Models
@using CSE325_Team4_GroupProject.Services
@inject ProductService ProductService
@inject ReviewService ReviewService
@inject CartService CartService
@inject AuthStateService AuthStateService
@inject NavigationManager Navigation

<PageTitle>ShopHub - @(product?.Name ?? "Product")</PageTitle>

@if (isLoading)
{
    <p class="loading">Loading product...</p>
}
else if (product == null)
{
    <div class="not-found">
        <h2>Product not found</h2>
        <a href="/products">← Browse products</a>
    </div>
}
else
{
    <div class="product-page">
        <div class="product-main">
            <div class="product-image-wrap">
                @if (!string.IsNullOrEmpty(product.ImageUrl))
                {
                    <img src="@product.ImageUrl" alt="@product.Name" class="product-image" />
                }
                else
                {
                    <div class="no-image">No image</div>
                }
            </div>

            <div class="product-info">
                <h1>@product.Name</h1>
                <div class="rating-line">
                    <span class="stars">@StarDisplay(product.Rating)</span>
                    <span class="rating-num">@product.Rating.ToString("0.0")</span>
                    <span class="review-count">(@reviews.Count review@(reviews.Count == 1 ? "" : "s"))</span>
                </div>
                <p class="price">₦@product.Price.ToString("N2")</p>
                <p class="meta"><strong>Category:</strong> @product.Category</p>
                <p class="meta"><strong>Seller:</strong> @(product.SellerName ?? "Unknown")</p>
                <p class="meta"><strong>Stock:</strong> @(product.Stock > 0 ? product.Stock.ToString() : "Out of stock")</p>
                <p class="description">@product.Description</p>

                <button class="btn-cart" @onclick="AddToCart" disabled="@(product.Stock <= 0)">
                    @(cartMessage ?? (product.Stock <= 0 ? "Out of Stock" : "Add to Cart"))
                </button>
            </div>
        </div>

        <!-- REVIEWS SECTION -->
        <section class="reviews-section">
            <h2>Customer Reviews</h2>

            @if (!string.IsNullOrEmpty(reviewMessage))
            {
                <div class="alert @(reviewError ? "alert-danger" : "alert-success")">@reviewMessage</div>
            }

            <!-- Leave / update review form -->
            @if (AuthStateService.CurrentUser == null)
            {
                <div class="login-prompt">
                    <p><a href="/login">Log in</a> to leave a rating and comment.</p>
                </div>
            }
            else
            {
                <div class="review-form">
                    <h3>@(existingReview == null ? "Write a review" : "Update your review")</h3>
                    <div class="star-picker">
                        <label>Your rating:</label>
                        <div class="star-buttons">
                            @for (int i = 1; i <= 5; i++)
                            {
                                var starValue = i;
                                <button type="button"
                                        class="star-btn @(formRating >= starValue ? "selected" : "")"
                                        @onclick="() => SetRating(starValue)">
                                    ★
                                </button>
                            }
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Comment (optional)</label>
                        <textarea class="form-control" rows="3" @bind="formComment"
                                  placeholder="Share your experience with this product..."></textarea>
                    </div>
                    <div class="form-actions">
                        <button class="btn-submit" @onclick="SubmitReview" disabled="@(isSubmitting || formRating < 1)">
                            @(isSubmitting ? "Saving..." : (existingReview == null ? "Submit Review" : "Update Review"))
                        </button>
                        @if (existingReview != null)
                        {
                            <button class="btn-delete-review" @onclick="DeleteMyReview" disabled="@isSubmitting">
                                Delete my review
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Review list -->
            @if (reviews.Count == 0)
            {
                <p class="no-reviews">No reviews yet. Be the first to review this product!</p>
            }
            else
            {
                <div class="review-list">
                    @foreach (var r in reviews)
                    {
                        <div class="review-card">
                            <div class="review-header">
                                <span class="reviewer">
                                    @(r.User != null
                                        ? $"{r.User.FirstName} {r.User.LastName}".Trim()
                                        : "User")
                                </span>
                                <span class="review-stars">@StarDisplay(r.Rating)</span>
                                <span class="review-date">@r.CreatedAt.ToString("MMM d, yyyy")</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(r.Comment))
                            {
                                <p class="review-comment">@r.Comment</p>
                            }
                            else
                            {
                                <p class="review-comment muted">No comment</p>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}

<style>
    .loading, .not-found { padding: 40px 0; text-align: center; }
    .product-page { padding: 10px 0 40px; }
    .product-main {
        display: flex;
        gap: 40px;
        align-items: flex-start;
        flex-wrap: wrap;
        margin-bottom: 40px;
    }
    .product-image-wrap { flex: 0 0 auto; }
    .product-image {
        width: 360px;
        max-width: 100%;
        height: 360px;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    }
    .no-image {
        width: 360px;
        height: 360px;
        background: #ecf0f1;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #95a5a6;
    }
    .product-info { flex: 1; min-width: 260px; }
    .product-info h1 { margin: 0 0 10px; color: #2c3e50; font-size: 28px; }
    .rating-line { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
    .stars { color: #f1c40f; letter-spacing: 1px; }
    .rating-num { font-weight: 700; color: #2c3e50; }
    .review-count { color: #7f8c8d; font-size: 14px; }
    .price { font-size: 28px; font-weight: 700; color: #e74c3c; margin: 8px 0 16px; }
    .meta { margin: 6px 0; color: #555; font-size: 15px; }
    .description { margin: 16px 0; color: #555; line-height: 1.5; }
    .btn-cart {
        margin-top: 12px;
        padding: 14px 28px;
        background: #2c3e50;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
    }
    .btn-cart:hover:not(:disabled) { background: #1a252f; }
    .btn-cart:disabled { opacity: 0.6; cursor: not-allowed; }

    .reviews-section {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 28px;
    }
    .reviews-section h2 { margin: 0 0 20px; color: #2c3e50; font-size: 22px; }
    .login-prompt {
        background: white;
        padding: 16px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    .login-prompt a { color: #3498db; font-weight: 600; }

    .review-form {
        background: white;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    .review-form h3 { margin: 0 0 14px; font-size: 17px; color: #2c3e50; }
    .star-picker { margin-bottom: 14px; }
    .star-picker label { display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px; }
    .star-buttons { display: flex; gap: 4px; }
    .star-btn {
        background: none;
        border: none;
        font-size: 28px;
        color: #ddd;
        cursor: pointer;
        padding: 0 2px;
        line-height: 1;
    }
    .star-btn.selected, .star-btn:hover { color: #f1c40f; }
    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px; }
    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        box-sizing: border-box;
        resize: vertical;
    }
    .form-actions { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn-submit {
        background: linear-gradient(135deg, #27ae60, #2ecc71);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
    }
    .btn-submit:disabled { opacity: 0.55; cursor: not-allowed; }
    .btn-delete-review {
        background: #e74c3c;
        color: white;
        border: none;
        padding: 10px 16px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
    }

    .no-reviews { color: #7f8c8d; font-style: italic; }
    .review-list { display: flex; flex-direction: column; gap: 12px; }
    .review-card {
        background: white;
        padding: 16px 18px;
        border-radius: 8px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    }
    .review-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        margin-bottom: 6px;
    }
    .reviewer { font-weight: 700; color: #2c3e50; }
    .review-stars { color: #f1c40f; }
    .review-date { color: #95a5a6; font-size: 13px; margin-left: auto; }
    .review-comment { margin: 4px 0 0; color: #555; line-height: 1.45; }
    .review-comment.muted { color: #bdc3c7; font-style: italic; }

    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        font-size: 14px;
    }
    .alert-success { background: #d4edda; color: #155724; }
    .alert-danger { background: #f8d7da; color: #721c24; }

    @@media (max-width: 700px) {
        .product-image, .no-image { width: 100%; height: 260px; }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;
    private List<Review> reviews = new();
    private Review? existingReview;
    private bool isLoading = true;
    private bool isSubmitting;
    private int formRating;
    private string formComment = "";
    private string reviewMessage = "";
    private bool reviewError;
    private string? cartMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        reviewMessage = "";
        cartMessage = null;

        product = await ProductService.GetProductByIdAsync(Id);
        if (product != null)
        {
            reviews = await ReviewService.GetReviewsByProductAsync(Id);

            existingReview = null;
            formRating = 0;
            formComment = "";

            if (AuthStateService.CurrentUser != null)
            {
                existingReview = await ReviewService.GetUserReviewForProductAsync(Id, AuthStateService.CurrentUser.Id);
                if (existingReview != null)
                {
                    formRating = existingReview.Rating;
                    formComment = existingReview.Comment ?? "";
                }
            }
        }

        isLoading = false;
    }

    private void SetRating(int value)
    {
        formRating = value;
    }

    private async Task SubmitReview()
    {
        if (AuthStateService.CurrentUser == null || formRating < 1)
            return;

        isSubmitting = true;
        reviewMessage = "";

        var result = await ReviewService.AddOrUpdateReviewAsync(
            Id,
            AuthStateService.CurrentUser.Id,
            formRating,
            formComment);

        reviewError = !result.Success;
        reviewMessage = result.Message;
        isSubmitting = false;

        if (result.Success)
        {
            await LoadData();
        }
    }

    private async Task DeleteMyReview()
    {
        if (AuthStateService.CurrentUser == null || existingReview == null)
            return;

        isSubmitting = true;
        var result = await ReviewService.DeleteReviewAsync(
            existingReview.Id,
            AuthStateService.CurrentUser.Id);

        reviewError = !result.Success;
        reviewMessage = result.Message;
        isSubmitting = false;

        if (result.Success)
        {
            await LoadData();
        }
    }

    private async Task AddToCart()
    {
        if (product == null || product.Stock <= 0)
            return;

        await CartService.Add(product);
        cartMessage = "Added to cart!";
        StateHasChanged();
    }

    private static string StarDisplay(double rating)
    {
        var full = (int)Math.Round(rating);
        if (full < 0) full = 0;
        if (full > 5) full = 5;
        return new string('★', full) + new string('☆', 5 - full);
    }

    private static string StarDisplay(int rating) => StarDisplay((double)rating);
}
