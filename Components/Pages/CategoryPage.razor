@page "/category/{Category}"
@using CSE325_Team4_GroupProject.Models
@inject CSE325_Team4_GroupProject.Services.ProductService ProductService

<PageTitle>ShopHub - @Category</PageTitle>

<div class="category-page">
    <nav class="breadcrumb">
        <a href="/">Home</a> <span>/</span> <a href="/products">Products</a> <span>/</span> <b>@Category</b>
    </nav>

    <div class="category-header">
        <h1>@CategoryIcon @Category</h1>
        <p>@productCount product@(productCount == 1 ? "" : "s") in this category</p>
    </div>

    @if (isLoading)
    {
        <p class="loading-text">Loading products...</p>
    }
    else if (!products.Any())
    {
        <div class="empty-category">
            <p>😕 No products found in this category yet.</p>
            <p>Be the first to sell in @Category!</p>
            <a class="btn btn-primary" href="/seller">Start Selling</a>
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in products)
            {
                <ProductCard Product="product" />
            }
        </div>
    }
</div>

<style>
    .category-page {
        padding: 20px 0;
    }

    .breadcrumb {
        font-size: 14px;
        margin-bottom: 20px;
        color: #7f8c8d;
    }

    .breadcrumb a {
        color: #3498db;
        text-decoration: none;
    }

    .breadcrumb a:hover {
        text-decoration: underline;
    }

    .category-header {
        background: linear-gradient(135deg, #2c3e50, #3498db);
        color: white;
        padding: 35px 30px;
        border-radius: 12px;
        margin-bottom: 30px;
    }

    .category-header h1 {
        margin: 0 0 5px;
        font-size: 34px;
    }

    .category-header p {
        margin: 0;
        opacity: 0.85;
        font-size: 15px;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
    }

    .loading-text {
        color: #7f8c8d;
        font-size: 16px;
    }

    .empty-category {
        text-align: center;
        padding: 60px 20px;
        background: #f8f9fa;
        border-radius: 12px;
    }

    .empty-category p {
        color: #555;
        font-size: 17px;
        margin: 8px 0;
    }

    .btn {
        padding: 10px 18px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: background 0.3s;
        margin-top: 15px;
    }

    .btn-primary {
        background: #f1c40f;
        color: #2c3e50;
    }

    .btn-primary:hover {
        background: #f39c12;
    }
</style>

@code {
    [Parameter]
    public string Category { get; set; } = "";

    private List<Product> products = new();
    private int productCount;
    private bool isLoading = true;

    private string CategoryIcon => Category.ToLower() switch
    {
        "clothing" => "👕",
        "food" => "🍕",
        "furniture" => "🪑",
        "electronics" => "📱",
        "books" => "📚",
        "games" => "🎮",
        "sports" => "👟",
        "beauty" => "💄",
        "automotive" => "🚗",
        "home & garden" => "🏠",
        _ => "🛍️"
    };

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        await ProductService.SeedProductsAsync();
        products = await ProductService.GetProductsByCategoryAsync(Category);
        productCount = products.Count;
        isLoading = false;
    }
}
