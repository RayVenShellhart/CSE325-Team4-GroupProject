@page "/seller/products"
@rendermode InteractiveServer
@using CSE325_Team4_GroupProject.Models
@using CSE325_Team4_GroupProject.Services
@inject ProductService ProductService
@inject AuthStateService AuthStateService
@inject NavigationManager Navigation

<PageTitle>ShopHub - My Products</PageTitle>

@if (!IsSeller)
{
    <div class="alert alert-warning mt-4">
        <h4>Access denied</h4>
        <p>You must be logged in as a Seller to manage products.</p>
        <a href="/login" class="btn btn-primary">Login</a>
    </div>
}
else
{
    <div class="seller-page">
        <div class="page-header">
            <div>
                <h1>📦 My Products</h1>
                <p class="subtitle">Manage the products you sell on ShopHub</p>
            </div>
            <a href="/seller/products/add" class="btn-add">+ Add Product</a>
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success")">@statusMessage</div>
        }

        @if (isLoading)
        {
            <p>Loading your products...</p>
        }
        else if (products.Count == 0)
        {
            <div class="empty-state">
                <p>You have not listed any products yet.</p>
                <a href="/seller/products/add" class="btn-add">Add your first product</a>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in products)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                                    {
                                        <img src="@p.ImageUrl" alt="@p.Name" class="thumb" />
                                    }
                                    else
                                    {
                                        <span class="no-img">—</span>
                                    }
                                </td>
                                <td>
                                    <strong>@p.Name</strong>
                                    <div class="muted">⭐ @p.Rating.ToString("0.0")</div>
                                </td>
                                <td>@p.Category</td>
                                <td>₦@p.Price.ToString("N2")</td>
                                <td>@p.Stock</td>
                                <td>
                                    <span class="badge @(p.IsActive ? "badge-active" : "badge-inactive")">
                                        @(p.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="actions">
                                    <a href="/seller/products/edit/@p.Id" class="btn-sm btn-edit">Edit</a>
                                    <button class="btn-sm btn-toggle" @onclick="() => ToggleActive(p)">
                                        @(p.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                    <button class="btn-sm btn-delete" @onclick="() => ConfirmDelete(p)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

<style>
    .seller-page { padding: 10px 0 40px; }
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }
    .page-header h1 { margin: 0 0 4px; font-size: 28px; color: #2c3e50; }
    .subtitle { margin: 0; color: #7f8c8d; font-size: 14px; }
    .btn-add {
        background: linear-gradient(135deg, #27ae60, #2ecc71);
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        display: inline-block;
    }
    .btn-add:hover { opacity: 0.9; color: white; }
    .table-wrap { overflow-x: auto; background: white; border-radius: 10px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
    .product-table { width: 100%; border-collapse: collapse; }
    .product-table th {
        text-align: left;
        padding: 14px 12px;
        background: #2c3e50;
        color: white;
        font-size: 13px;
        font-weight: 600;
    }
    .product-table td { padding: 12px; border-bottom: 1px solid #eee; vertical-align: middle; font-size: 14px; }
    .thumb { width: 56px; height: 56px; object-fit: cover; border-radius: 6px; }
    .no-img { color: #bbb; }
    .muted { color: #95a5a6; font-size: 12px; margin-top: 2px; }
    .badge { padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
    .badge-active { background: #d4edda; color: #155724; }
    .badge-inactive { background: #f8d7da; color: #721c24; }
    .actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .btn-sm {
        border: none;
        padding: 6px 10px;
        border-radius: 5px;
        font-size: 12px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }
    .btn-edit { background: #3498db; color: white; }
    .btn-toggle { background: #f39c12; color: white; }
    .btn-delete { background: #e74c3c; color: white; }
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: #f8f9fa;
        border-radius: 10px;
    }
    .alert { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; }
    .alert-success { background: #d4edda; color: #155724; }
    .alert-danger { background: #f8d7da; color: #721c24; }
    .alert-warning { background: #fff3cd; color: #856404; padding: 24px; border-radius: 10px; }
</style>

@code {
    private List<Product> products = new();
    private bool isLoading = true;
    private string statusMessage = "";
    private bool isError;

    private bool IsSeller =>
        AuthStateService.CurrentUser != null &&
        (AuthStateService.CurrentUser.UserType is "Seller" or "Both" or "Admin");

    protected override async Task OnInitializedAsync()
    {
        if (!IsSeller)
        {
            isLoading = false;
            return;
        }

        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        var user = AuthStateService.CurrentUser!;
        if (user.UserType == "Admin")
        {
            products = await ProductService.GetAllProductsIncludingInactiveAsync();
        }
        else
        {
            products = await ProductService.GetProductsBySellerAsync(user.Id);
        }
        isLoading = false;
    }

    private async Task ToggleActive(Product p)
    {
        var user = AuthStateService.CurrentUser!;
        int? ownerCheck = user.UserType == "Admin" ? null : user.Id;
        var ok = await ProductService.SetProductActiveStatusAsync(p.Id, !p.IsActive, ownerCheck);
        if (ok)
        {
            statusMessage = $"Product \"{p.Name}\" is now {(p.IsActive ? "inactive" : "active")}.";
            isError = false;
            await LoadProducts();
        }
        else
        {
            statusMessage = "Could not update product status.";
            isError = true;
        }
    }

    private async Task ConfirmDelete(Product p)
    {
        var user = AuthStateService.CurrentUser!;
        int? ownerCheck = user.UserType == "Admin" ? null : user.Id;
        var ok = await ProductService.DeleteProductAsync(p.Id, ownerCheck);
        if (ok)
        {
            statusMessage = $"Deleted \"{p.Name}\".";
            isError = false;
            await LoadProducts();
        }
        else
        {
            statusMessage = "Could not delete product.";
            isError = true;
        }
    }
}
