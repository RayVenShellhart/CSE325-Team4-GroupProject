@page "/seller/products/edit/{Id:int}"
@rendermode InteractiveServer
@using CSE325_Team4_GroupProject.Models
@using CSE325_Team4_GroupProject.Services
@inject ProductService ProductService
@inject AuthStateService AuthStateService
@inject NavigationManager Navigation

<PageTitle>ShopHub - Edit Product</PageTitle>

@if (!IsSeller)
{
    <div class="alert alert-warning mt-4">
        <h4>Access denied</h4>
        <p>You must be logged in as a Seller to edit products.</p>
        <a href="/login" class="btn btn-primary">Login</a>
    </div>
}
else if (isLoading)
{
    <p>Loading product...</p>
}
else if (product == null)
{
    <div class="alert alert-warning mt-4">
        <h4>Product not found</h4>
        <a href="/seller/products">← Back to My Products</a>
    </div>
}
else
{
    <div class="form-page">
        <div class="form-header">
            <h1>✏️ Edit Product</h1>
            <a href="/seller/products" class="back-link">← Back to My Products</a>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <div class="form-card">
            <div class="form-group">
                <label>Product Name *</label>
                <input class="form-control" @bind="product.Name" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Price (₦) *</label>
                    <input type="number" step="0.01" min="0" class="form-control" @bind="product.Price" />
                </div>
                <div class="form-group">
                    <label>Stock *</label>
                    <input type="number" min="0" class="form-control" @bind="product.Stock" />
                </div>
            </div>

            <div class="form-group">
                <label>Category *</label>
                <select class="form-control" @bind="product.Category">
                    <option value="Clothing">Clothing</option>
                    <option value="Electronics">Electronics</option>
                    <option value="Furniture">Furniture</option>
                    <option value="Books">Books</option>
                    <option value="Food">Food</option>
                    <option value="Games">Games</option>
                    <option value="Sports">Sports</option>
                    <option value="Beauty">Beauty</option>
                    <option value="Automotive">Automotive</option>
                    <option value="Home & Garden">Home & Garden</option>
                </select>
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea class="form-control" rows="4" @bind="product.Description"></textarea>
            </div>

            <div class="form-group">
                <label>Image URL</label>
                <input class="form-control" @bind="product.ImageUrl" />
            </div>

            @if (!string.IsNullOrEmpty(product.ImageUrl))
            {
                <div class="preview">
                    <img src="@product.ImageUrl" alt="Preview" onerror="this.style.display='none'" />
                </div>
            }

            <div class="form-group checkbox-row">
                <input type="checkbox" id="isActive" @bind="product.IsActive" />
                <label for="isActive">Product is active (visible in store)</label>
            </div>

            <div class="form-actions">
                <button class="btn-save" @onclick="Save" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Update Product")
                </button>
                <a href="/seller/products" class="btn-cancel">Cancel</a>
            </div>
        </div>
    </div>
}

<style>
    .form-page { max-width: 640px; margin: 0 auto; padding: 10px 0 40px; }
    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 10px;
    }
    .form-header h1 { margin: 0; font-size: 26px; color: #2c3e50; }
    .back-link { color: #3498db; text-decoration: none; font-size: 14px; }
    .form-card {
        background: white;
        padding: 28px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }
    .form-group { margin-bottom: 18px; }
    .form-group label {
        display: block;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 6px;
        color: #2c3e50;
    }
    .form-row { display: flex; gap: 16px; }
    .form-row .form-group { flex: 1; }
    .form-control {
        width: 100%;
        padding: 11px 14px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        box-sizing: border-box;
    }
    .form-control:focus {
        border-color: #3498db;
        outline: none;
        box-shadow: 0 0 0 3px rgba(52,152,219,0.12);
    }
    textarea.form-control { resize: vertical; }
    .preview { margin-bottom: 18px; }
    .preview img {
        max-width: 200px;
        max-height: 200px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #eee;
    }
    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .checkbox-row input { width: 18px; height: 18px; }
    .checkbox-row label { margin: 0; font-weight: 500; }
    .form-actions { display: flex; gap: 12px; align-items: center; margin-top: 8px; }
    .btn-save {
        background: linear-gradient(135deg, #2980b9, #3498db);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 15px;
        cursor: pointer;
    }
    .btn-save:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-cancel { color: #7f8c8d; text-decoration: none; font-size: 14px; }
    .alert-danger {
        background: #f8d7da; color: #721c24;
        padding: 12px 16px; border-radius: 8px; margin-bottom: 16px;
    }
    .alert-success {
        background: #d4edda; color: #155724;
        padding: 12px 16px; border-radius: 8px; margin-bottom: 16px;
    }
    .alert-warning {
        background: #fff3cd; color: #856404;
        padding: 24px; border-radius: 10px;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private Product? product;
    private bool isLoading = true;
    private bool isSaving;
    private string errorMessage = "";
    private string successMessage = "";

    private bool IsSeller =>
        AuthStateService.CurrentUser != null &&
        (AuthStateService.CurrentUser.UserType is "Seller" or "Both" or "Admin");

    protected override async Task OnParametersSetAsync()
    {
        if (!IsSeller)
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        product = await ProductService.GetProductByIdAsync(Id);

        // Ownership check (Admin can edit any)
        var user = AuthStateService.CurrentUser!;
        if (product != null && user.UserType != "Admin" && product.SellerId != user.Id)
        {
            product = null;
        }

        isLoading = false;
    }

    private async Task Save()
    {
        if (product == null) return;

        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(product.Name))
        {
            errorMessage = "Product name is required.";
            return;
        }
        if (product.Price <= 0)
        {
            errorMessage = "Price must be greater than zero.";
            return;
        }
        if (string.IsNullOrWhiteSpace(product.Category))
        {
            errorMessage = "Please select a category.";
            return;
        }
        if (product.Stock < 0)
        {
            errorMessage = "Stock cannot be negative.";
            return;
        }

        isSaving = true;
        var updated = await ProductService.UpdateProductAsync(product);
        isSaving = false;

        if (updated == null)
        {
            errorMessage = "Failed to update product.";
            return;
        }

        successMessage = "Product updated successfully.";
        await Task.Delay(600);
        Navigation.NavigateTo("/seller/products");
    }
}
