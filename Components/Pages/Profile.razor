@page "/profile"
@using CSE325_Team4_GroupProject.Models
@using CSE325_Team4_GroupProject.Services
@inject AuthStateService AuthStateService
@inject UserService UserService
@inject NavigationManager Navigation

<PageTitle>ShopHub - Profile</PageTitle>

@if (AuthStateService.CurrentUser == null)
{
    <div class="profile-page">
        <div class="alert alert-warning">
            <h3>Not logged in</h3>
            <p>Please <a href="/login">log in</a> to view your profile.</p>
        </div>
    </div>
}
else
{
    <div class="profile-page">
        <h1>My Profile</h1>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success")">@statusMessage</div>
        }

        <div class="profile-card">
            <div class="profile-header">
                <div class="avatar">@(Initials)</div>
                <div>
                    <h2>@user.FirstName @user.LastName</h2>
                    <span class="role-badge">@user.UserType</span>
                    <span class="status-badge @(user.IsActive ? "active" : "inactive")">
                        @(user.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>First Name</label>
                    <input class="form-control" @bind="user.FirstName" />
                </div>
                <div class="form-group">
                    <label>Last Name</label>
                    <input class="form-control" @bind="user.LastName" />
                </div>
                <div class="form-group full">
                    <label>Email</label>
                    <input class="form-control" @bind="user.Email" type="email" />
                </div>
                <div class="form-group">
                    <label>Phone</label>
                    <input class="form-control" @bind="user.PhoneNumber" />
                </div>
                <div class="form-group">
                    <label>User Type</label>
                    <input class="form-control" value="@user.UserType" disabled />
                    <small class="hint">Contact an admin to change your role.</small>
                </div>
                <div class="form-group full">
                    <label>Address</label>
                    <input class="form-control" @bind="user.Address" />
                </div>
                <div class="form-group full">
                    <label>New Password (leave blank to keep current)</label>
                    <input class="form-control" type="password" @bind="newPassword" placeholder="••••••••" />
                </div>
            </div>

            <div class="actions">
                <button class="btn-save" @onclick="SaveProfile" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save Changes")
                </button>
                @if (IsSellerOrAdmin)
                {
                    <a href="/seller/products" class="btn-link">My Products →</a>
                }
            </div>

            <p class="meta">Member since @user.CreatedAt.ToString("MMM d, yyyy")</p>
        </div>
    </div>
}

<style>
    .profile-page { max-width: 640px; margin: 0 auto; padding: 10px 0 40px; }
    .profile-page h1 { color: #2c3e50; margin-bottom: 20px; }
    .profile-card {
        background: white;
        border-radius: 12px;
        padding: 28px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }
    .profile-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        padding-bottom: 20px;
        border-bottom: 1px solid #eee;
    }
    .avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2c3e50, #3498db);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 700;
    }
    .profile-header h2 { margin: 0 0 6px; font-size: 22px; color: #2c3e50; }
    .role-badge {
        background: #eaf2f8;
        color: #2980b9;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        margin-right: 6px;
    }
    .status-badge {
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }
    .status-badge.active { background: #d4edda; color: #155724; }
    .status-badge.inactive { background: #f8d7da; color: #721c24; }
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    .form-group.full { grid-column: 1 / -1; }
    .form-group label {
        display: block;
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 5px;
        color: #2c3e50;
    }
    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        box-sizing: border-box;
    }
    .form-control:focus {
        border-color: #3498db;
        outline: none;
        box-shadow: 0 0 0 3px rgba(52,152,219,0.12);
    }
    .form-control:disabled { background: #f5f5f5; color: #777; }
    .hint { color: #95a5a6; font-size: 12px; }
    .actions {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-top: 24px;
        flex-wrap: wrap;
    }
    .btn-save {
        background: linear-gradient(135deg, #2980b9, #3498db);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }
    .btn-save:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-link { color: #3498db; text-decoration: none; font-weight: 600; font-size: 14px; }
    .meta { margin-top: 20px; color: #95a5a6; font-size: 13px; }
    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
    }
    .alert-success { background: #d4edda; color: #155724; }
    .alert-danger { background: #f8d7da; color: #721c24; }
    .alert-warning {
        background: #fff3cd;
        color: #856404;
        padding: 24px;
        border-radius: 10px;
    }
    @@media (max-width: 560px) {
        .form-grid { grid-template-columns: 1fr; }
    }
</style>

@code {
    private User user = new();
    private string newPassword = "";
    private string statusMessage = "";
    private bool isError;
    private bool isSaving;

    private bool IsSellerOrAdmin =>
        user.UserType is "Seller" or "Both" or "Admin";

    private string Initials
    {
        get
        {
            var f = user.FirstName?.FirstOrDefault().ToString() ?? "";
            var l = user.LastName?.FirstOrDefault().ToString() ?? "";
            var s = (f + l).ToUpper();
            return string.IsNullOrEmpty(s) ? "?" : s;
        }
    }

    protected override void OnInitialized()
    {
        if (AuthStateService.CurrentUser != null)
        {
            // Work on a copy so cancel isn't needed; save pushes to DB + auth state
            var c = AuthStateService.CurrentUser;
            user = new User
            {
                Id = c.Id,
                FirstName = c.FirstName,
                LastName = c.LastName,
                Email = c.Email,
                PhoneNumber = c.PhoneNumber,
                Address = c.Address,
                ProfileImage = c.ProfileImage,
                UserType = c.UserType,
                IsActive = c.IsActive,
                CreatedAt = c.CreatedAt,
                Password = c.Password
            };
        }
    }

    private async Task SaveProfile()
    {
        statusMessage = "";
        isError = false;

        if (string.IsNullOrWhiteSpace(user.FirstName) || string.IsNullOrWhiteSpace(user.LastName))
        {
            statusMessage = "First and last name are required.";
            isError = true;
            return;
        }
        if (string.IsNullOrWhiteSpace(user.Email))
        {
            statusMessage = "Email is required.";
            isError = true;
            return;
        }

        isSaving = true;

        // Only update password if a new one was entered
        if (!string.IsNullOrWhiteSpace(newPassword))
        {
            if (newPassword.Length < 6)
            {
                statusMessage = "Password must be at least 6 characters.";
                isError = true;
                isSaving = false;
                return;
            }
            user.Password = newPassword;
        }
        else
        {
            user.Password = null; // UserService skips password when null/empty
        }

        // Preserve role/active from current auth user (user cannot self-change these here)
        user.UserType = AuthStateService.CurrentUser!.UserType;
        user.IsActive = AuthStateService.CurrentUser.IsActive;

        var ok = await UserService.UpdateUserAsync(user);
        isSaving = false;

        if (!ok)
        {
            statusMessage = "Could not update profile. Email may already be in use.";
            isError = true;
            return;
        }

        // Refresh auth state with latest data
        var refreshed = await UserService.GetUserByIdAsync(user.Id);
        if (refreshed != null)
        {
            AuthStateService.SetUser(refreshed);
            user.Password = refreshed.Password;
        }

        newPassword = "";
        statusMessage = "Profile updated successfully.";
        isError = false;
    }
}
