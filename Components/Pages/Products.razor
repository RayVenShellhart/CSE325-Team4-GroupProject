@page "/products"
@using CSE325_Team4_GroupProject.Models
@inject CSE325_Team4_GroupProject.Services.ProductService ProductService

<PageTitle>ShopHub - Products</PageTitle>

<div class="products-page">
    <h1>All Products</h1>

    <div class="filters">
        <div class="filter-group">
            <label>Category:</label>
            <select @bind="selectedCategory">
                <option value="">All</option>
                <option value="Clothing">Clothing</option>
                <option value="Electronics">Electronics</option>
                <option value="Furniture">Furniture</option>
                <option value="Books">Books</option>
                <option value="Food">Food</option>
                <option value="Games">Games</option>
                <option value="Sports">Sports</option>
                <option value="Beauty">Beauty</option>
            </select>
        </div>

        <div class="filter-group">
            <label>Sort by:</label>
            <select @bind="sortBy">
                <option value="name">Name</option>
                <option value="price_low">Price: Low to High</option>
                <option value="price_high">Price: High to Low</option>
                <option value="rating">Rating</option>
            </select>
        </div>

        <div class="filter-group">
            <label>Search:</label>
            <input type="text" @bind="searchTerm" placeholder="Search products..." />
        </div>
    </div>

    <div class="product-grid">
        @foreach (var product in filteredProducts)
        {
            <ProductCard Product="product" />
        }
    </div>
</div>

<style>
    .products-page {
        padding: 20px 0;
    }

    .filters {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 30px;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .filter-group {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .filter-group label {
        font-weight: bold;
        font-size: 14px;
    }

    .filter-group select,
    .filter-group input {
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 14px;
    }

    .filter-group input {
        min-width: 200px;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
    }
</style>

@code {
    private List<Product> allProducts = new();
    private string selectedCategory = "";
    private string sortBy = "name";
    private string searchTerm = "";

    private List<Product> filteredProducts
    {
        get
        {
            var result = allProducts.AsEnumerable();

            if (!string.IsNullOrEmpty(selectedCategory))
            {
                result = result.Where(p => p.Category == selectedCategory);
            }

            if (!string.IsNullOrEmpty(searchTerm))
            {
                result = result.Where(p =>
                    (p.Name != null && p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (p.Description != null && p.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                );
            }

            result = sortBy switch
            {
                "price_low" => result.OrderBy(p => p.Price),
                "price_high" => result.OrderByDescending(p => p.Price),
                "rating" => result.OrderByDescending(p => p.Rating),
                _ => result.OrderBy(p => p.Name)
            };

            return result.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ProductService.SeedProductsAsync();
        allProducts = await ProductService.GetAllProductsAsync();
    }
}