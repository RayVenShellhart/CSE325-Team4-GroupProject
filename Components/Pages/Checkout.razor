@page "/checkout"
@using CSE325_Team4_GroupProject.Services
@inject CartService Cart
@inject AuthStateService AuthStateService
@inject NavigationManager Navigation

<PageTitle>ShopHub - Checkout</PageTitle>

<div class="checkout-page">
    <h1>Checkout</h1>

    @if (!Cart.Items.Any())
    {
        <div class="empty-cart">
            <p>Your cart is empty. Add items before checking out.</p>
            <a class="btn btn-primary" href="/products">Browse products</a>
        </div>
    }
    else
    {
        <div class="checkout-layout">
            <div class="checkout-form">
                <h2>Shipping Information</h2>
                <label>Full Name *</label>
                <input @bind="fullName" placeholder="Full name" />

                <label>Email *</label>
                <input @bind="email" type="email" placeholder="you@example.com" />

                <label>Address *</label>
                <input @bind="address" placeholder="Street address" />

                <label>City *</label>
                <input @bind="city" placeholder="City" />

                <label>Phone *</label>
                <input @bind="phone" placeholder="Phone number" />

                <h2 class="section-title">Payment Method *</h2>
                <div class="payment-options">
                    <label class="payment-option @(paymentMethod == "Card" ? "selected" : "")">
                        <input type="radio" name="payment" value="Card" checked="@(paymentMethod == "Card")" @onchange="OnPaymentChanged" />
                        <span class="option-icon">💳</span>
                        <span>Debit / Credit Card</span>
                    </label>
                    <label class="payment-option @(paymentMethod == "BankTransfer" ? "selected" : "")">
                        <input type="radio" name="payment" value="BankTransfer" checked="@(paymentMethod == "BankTransfer")" @onchange="OnPaymentChanged" />
                        <span class="option-icon">🏦</span>
                        <span>Bank Transfer</span>
                    </label>
                    <label class="payment-option @(paymentMethod == "MobileMoney" ? "selected" : "")">
                        <input type="radio" name="payment" value="MobileMoney" checked="@(paymentMethod == "MobileMoney")" @onchange="OnPaymentChanged" />
                        <span class="option-icon">📱</span>
                        <span>Mobile Money</span>
                    </label>
                    <label class="payment-option @(paymentMethod == "CashOnDelivery" ? "selected" : "")">
                        <input type="radio" name="payment" value="CashOnDelivery" checked="@(paymentMethod == "CashOnDelivery")" @onchange="OnPaymentChanged" />
                        <span class="option-icon">💵</span>
                        <span>Cash on Delivery</span>
                    </label>
                </div>

                @* ---- Dynamic payment detail fields ---- *@
                @if (paymentMethod == "Card")
                {
                    <div class="payment-details">
                        <h3>Card details</h3>
                        <label>Name on card *</label>
                        <input @bind="cardName" placeholder="Name as on card" />

                        <label>Card number *</label>
                        <input @bind="cardNumber" placeholder="1234 5678 9012 3456" maxlength="19" />

                        <div class="field-row">
                            <div class="field-half">
                                <label>Expiry (MM/YY) *</label>
                                <input @bind="cardExpiry" placeholder="MM/YY" maxlength="5" />
                            </div>
                            <div class="field-half">
                                <label>CVV *</label>
                                <input @bind="cardCvv" type="password" placeholder="123" maxlength="4" />
                            </div>
                        </div>
                        <p class="hint">Demo only — card details are not stored or charged in this project.</p>
                    </div>
                }
                else if (paymentMethod == "BankTransfer")
                {
                    <div class="payment-details">
                        <h3>Bank transfer</h3>
                        <div class="bank-info">
                            <p><strong>Bank:</strong> ShopHub Demo Bank</p>
                            <p><strong>Account name:</strong> ShopHub Marketplace Ltd</p>
                            <p><strong>Account number:</strong> 0123456789</p>
                            <p><strong>Amount:</strong> ₦@Cart.TotalPrice.ToString("N2")</p>
                        </div>
                        <label>Your transfer reference / receipt number *</label>
                        <input @bind="transferReference" placeholder="e.g. TXN123456 or receipt no." />
                        <label>Bank you transferred from (optional)</label>
                        <input @bind="transferFromBank" placeholder="e.g. GTBank, Access, Zenith" />
                        <p class="hint">Use your order email or phone as the transfer narration if possible.</p>
                    </div>
                }
                else if (paymentMethod == "MobileMoney")
                {
                    <div class="payment-details">
                        <h3>Mobile money</h3>
                        <label>Network *</label>
                        <select @bind="momoNetwork">
                            <option value="">Select network</option>
                            <option value="MTN">MTN MoMo</option>
                            <option value="Airtel">Airtel Money</option>
                            <option value="Glo">Glo</option>
                            <option value="9mobile">9mobile</option>
                            <option value="Other">Other</option>
                        </select>
                        <label>Mobile money phone number *</label>
                        <input @bind="momoPhone" placeholder="e.g. 08012345678" />
                        <p class="hint">You may receive a prompt on your phone to approve the payment (demo flow).</p>
                    </div>
                }
                else if (paymentMethod == "CashOnDelivery")
                {
                    <div class="payment-details">
                        <h3>Cash on delivery</h3>
                        <p class="cod-note">
                            Pay with cash when your order is delivered.
                            Please ensure someone is available at the shipping address to receive the order.
                        </p>
                        <label class="checkbox-row">
                            <input type="checkbox" @bind="codConfirmed" />
                            <span>I confirm I will pay cash on delivery *</span>
                        </label>
                    </div>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-msg">@errorMessage</div>
                }
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="success-msg">@successMessage</div>
                }

                <button class="btn btn-primary place-order-btn" @onclick="PlaceOrder" disabled="@isPlacing">
                    @(isPlacing ? "Processing..." : PlaceOrderButtonText)
                </button>
            </div>

            <div class="summary-card">
                <h2>Order Summary</h2>
                @foreach (var item in Cart.Items)
                {
                    <div class="summary-item">
                        <span>@item.Name x @item.Quantity</span>
                        <span>₦@((item.Price * item.Quantity).ToString("N2"))</span>
                    </div>
                }
                <div class="summary-row total">
                    <span>Total</span>
                    <span>₦@Cart.TotalPrice.ToString("N2")</span>
                </div>
                <div class="summary-payment">
                    Payment: @PaymentMethodLabel
                </div>
            </div>
        </div>
    }
</div>

<style>
    .checkout-page { padding: 20px 0; }
    .checkout-layout { display: grid; grid-template-columns: 2fr 1fr; gap: 24px; }
    .checkout-form {
        background: white;
        padding: 24px;
        border-radius: 10px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }
    .checkout-form h2 { margin: 0 0 16px; color: #2c3e50; font-size: 20px; }
    .section-title { margin-top: 28px !important; padding-top: 20px; border-top: 1px solid #eee; }
    .checkout-form label {
        display: block;
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 5px;
        color: #2c3e50;
    }
    .checkout-form input, .checkout-form select {
        display: block;
        width: 100%;
        padding: 10px 12px;
        margin-bottom: 14px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        box-sizing: border-box;
        background: white;
    }
    .checkout-form input:focus, .checkout-form select:focus {
        border-color: #3498db;
        outline: none;
        box-shadow: 0 0 0 3px rgba(52,152,219,0.12);
    }
    .field-row { display: flex; gap: 12px; }
    .field-half { flex: 1; }
    .payment-options {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 18px;
    }
    .payment-option {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        color: #2c3e50;
        transition: border-color 0.15s, background 0.15s;
    }
    .payment-option input { width: auto; margin: 0; }
    .payment-option.selected {
        border-color: #3498db;
        background: #eaf4fc;
    }
    .option-icon { font-size: 18px; }
    .payment-details {
        background: #f8f9fa;
        padding: 16px;
        border-radius: 8px;
        margin-bottom: 16px;
    }
    .payment-details h3 { margin: 0 0 12px; font-size: 16px; color: #2c3e50; }
    .bank-info {
        background: white;
        border: 1px dashed #bdc3c7;
        border-radius: 6px;
        padding: 12px 14px;
        margin-bottom: 14px;
        font-size: 14px;
        color: #2c3e50;
    }
    .bank-info p { margin: 4px 0; }
    .cod-note { color: #555; font-size: 14px; line-height: 1.5; margin: 0 0 12px; }
    .hint { color: #95a5a6; font-size: 12px; margin: -6px 0 10px; }
    .checkbox-row {
        display: flex !important;
        align-items: center;
        gap: 10px;
        font-weight: 500 !important;
        cursor: pointer;
        margin-bottom: 0 !important;
    }
    .checkbox-row input { width: auto !important; margin: 0 !important; }
    .place-order-btn {
        width: 100%;
        padding: 14px;
        margin-top: 8px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        border-radius: 8px;
        background: #f1c40f;
        color: #2c3e50;
    }
    .place-order-btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .summary-card {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        height: fit-content;
        position: sticky;
        top: 90px;
    }
    .summary-card h2 { margin: 0 0 16px; font-size: 18px; color: #2c3e50; }
    .summary-item, .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 14px;
    }
    .summary-row.total {
        font-weight: bold;
        font-size: 18px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #ddd;
    }
    .summary-payment { margin-top: 12px; font-size: 13px; color: #7f8c8d; }
    .empty-cart { text-align: center; padding: 40px; background: #f8f9fa; border-radius: 8px; }
    .btn { padding: 10px 18px; text-decoration: none; display: inline-block; }
    .btn-primary { background: #f1c40f; color: #2c3e50; border: none; border-radius: 5px; cursor: pointer; }
    .error-msg {
        background: #f8d7da; color: #721c24;
        padding: 10px 14px; border-radius: 6px; margin-bottom: 12px; font-size: 14px;
    }
    .success-msg {
        background: #d4edda; color: #155724;
        padding: 10px 14px; border-radius: 6px; margin-bottom: 12px; font-size: 14px;
    }
    @@media (max-width: 900px) {
        .checkout-layout { grid-template-columns: 1fr; }
        .summary-card { position: static; }
        .field-row { flex-direction: column; gap: 0; }
    }
</style>

@code {
    private string fullName = "";
    private string email = "";
    private string address = "";
    private string city = "";
    private string phone = "";

    private string paymentMethod = "Card";

    // Card
    private string cardName = "";
    private string cardNumber = "";
    private string cardExpiry = "";
    private string cardCvv = "";

    // Bank transfer
    private string transferReference = "";
    private string transferFromBank = "";

    // Mobile money
    private string momoNetwork = "";
    private string momoPhone = "";

    // COD
    private bool codConfirmed;

    private string errorMessage = "";
    private string successMessage = "";
    private bool isPlacing;

    private string PaymentMethodLabel => paymentMethod switch
    {
        "Card" => "Debit / Credit Card",
        "BankTransfer" => "Bank Transfer",
        "MobileMoney" => "Mobile Money",
        "CashOnDelivery" => "Cash on Delivery",
        _ => paymentMethod
    };

    private string PlaceOrderButtonText => paymentMethod switch
    {
        "Card" => $"Pay ₦{Cart.TotalPrice:N2} with Card",
        "BankTransfer" => "Confirm Bank Transfer",
        "MobileMoney" => $"Pay ₦{Cart.TotalPrice:N2} with Mobile Money",
        "CashOnDelivery" => "Place Order (Cash on Delivery)",
        _ => "Place Order"
    };

    protected override void OnInitialized()
    {
        var user = AuthStateService.CurrentUser;
        if (user != null)
        {
            fullName = $"{user.FirstName} {user.LastName}".Trim();
            email = user.Email ?? "";
            phone = user.PhoneNumber ?? "";
            address = user.Address ?? "";
            momoPhone = user.PhoneNumber ?? "";
        }
    }

    private void OnPaymentChanged(ChangeEventArgs e)
    {
        paymentMethod = e.Value?.ToString() ?? "Card";
        errorMessage = "";
        successMessage = "";
    }

    private async Task PlaceOrder()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(fullName) ||
            string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(address) ||
            string.IsNullOrWhiteSpace(city) ||
            string.IsNullOrWhiteSpace(phone))
        {
            errorMessage = "Please fill in all shipping fields.";
            return;
        }

        if (!email.Contains('@'))
        {
            errorMessage = "Please enter a valid email address.";
            return;
        }

        if (!ValidatePaymentDetails())
            return;

        isPlacing = true;
        successMessage = $"Order placed successfully via {PaymentMethodLabel}!";
        await Task.Delay(700);
        await Cart.Clear();
        isPlacing = false;
        Navigation.NavigateTo("/");
    }

    private bool ValidatePaymentDetails()
    {
        switch (paymentMethod)
        {
            case "Card":
                if (string.IsNullOrWhiteSpace(cardName) ||
                    string.IsNullOrWhiteSpace(cardNumber) ||
                    string.IsNullOrWhiteSpace(cardExpiry) ||
                    string.IsNullOrWhiteSpace(cardCvv))
                {
                    errorMessage = "Please complete all card details.";
                    return false;
                }
                var digits = new string(cardNumber.Where(char.IsDigit).ToArray());
                if (digits.Length < 13 || digits.Length > 19)
                {
                    errorMessage = "Enter a valid card number.";
                    return false;
                }
                if (cardCvv.Length < 3)
                {
                    errorMessage = "Enter a valid CVV.";
                    return false;
                }
                break;

            case "BankTransfer":
                if (string.IsNullOrWhiteSpace(transferReference))
                {
                    errorMessage = "Please enter your transfer reference or receipt number.";
                    return false;
                }
                break;

            case "MobileMoney":
                if (string.IsNullOrWhiteSpace(momoNetwork))
                {
                    errorMessage = "Please select a mobile money network.";
                    return false;
                }
                if (string.IsNullOrWhiteSpace(momoPhone) || momoPhone.Trim().Length < 10)
                {
                    errorMessage = "Please enter a valid mobile money phone number.";
                    return false;
                }
                break;

            case "CashOnDelivery":
                if (!codConfirmed)
                {
                    errorMessage = "Please confirm you will pay cash on delivery.";
                    return false;
                }
                break;
        }

        return true;
    }
}
