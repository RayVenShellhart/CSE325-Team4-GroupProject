@page "/checkout"
@inject CSE325_Team4_GroupProject.Services.CartService Cart
@inject CSE325_Team4_GroupProject.Services.OrderService OrderService
@inject CSE325_Team4_GroupProject.Services.AuthStateService AuthStateService
@inject NavigationManager Navigation

<PageTitle>ShopHub - Checkout</PageTitle>

<div class="checkout-page">
    <h1>Checkout</h1>

    @if (!Cart.Items.Any())
    {
        <div class="empty-cart">
            <p>Your cart is empty. Add items before checking out.</p>
            <a class="btn btn-primary" href="/products">Browse products</a>
        </div>
    }
    else
    {
        <div class="checkout-layout">
            <div class="checkout-form">
                <h2>Shipping Information</h2>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success">@successMessage</div>
                }

                <label for="shipName">Name</label>
                <input id="shipName" placeholder="Full name" @bind="shipping.Name" />

                <label for="shipAddress">Address</label>
                <input id="shipAddress" placeholder="Street address" @bind="shipping.Address" />

                <label for="shipCity">City</label>
                <input id="shipCity" placeholder="City" @bind="shipping.City" />

                <label for="shipPhone">Phone</label>
                <input id="shipPhone" type="tel" placeholder="Phone number" @bind="shipping.Phone" />

                <button class="btn btn-primary place-order-btn" @onclick="PlaceOrder" disabled="@isPlacingOrder">
                    @(isPlacingOrder ? "Placing Order..." : "Place Order")
                </button>
            </div>

            <div class="summary-card">
                <h2>Order Summary</h2>
                @foreach (var item in Cart.Items)
                {
                    <div class="summary-item">
                        <span>@item.Name x @item.Quantity</span>
                        <span>₦@((item.Price * item.Quantity).ToString("0.00"))</span>
                    </div>
                }
                <div class="summary-row total">
                    <span>Total</span>
                    <span>₦@Cart.TotalPrice.ToString("0.00")</span>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .checkout-page { padding: 20px 0; }
    .checkout-layout { display: grid; grid-template-columns: 2fr 1fr; gap: 24px; }
    .checkout-form { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .checkout-form input { display: block; width: 100%; padding: 10px; margin-bottom: 12px; border: 1px solid #ddd; border-radius: 5px; }
    .place-order-btn { width: 100%; padding: 12px; margin-top: 10px; }
    .summary-card { background: #f8f9fa; padding: 20px; border-radius: 8px; height: fit-content; }
    .summary-item, .summary-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
    .summary-row.total { font-weight: bold; font-size: 18px; }
    .empty-cart { text-align: center; padding: 40px; background: #f8f9fa; border-radius: 8px; }
    .btn { padding: 10px 18px; text-decoration: none; display: inline-block; }
    .btn-primary { background: #f1c40f; color: #2c3e50; border: none; border-radius: 5px; cursor: pointer; }
    .alert { padding: 12px 15px; border-radius: 6px; margin-bottom: 15px; font-size: 14px; }
    .alert-danger { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    .checkout-form input:focus { border-color: #3498db; outline: none; box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1); }
    @@media (max-width: 900px) { .checkout-layout { grid-template-columns: 1fr; } }
</style>

@code {
    private ShippingModel shipping = new();
    private string errorMessage = "";
    private string successMessage = "";
    private bool isPlacingOrder = false;
    private int? lastOrderId;

    // Check the shipping fields, save the order, then empty the cart.
    private async Task PlaceOrder()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(shipping.Name) ||
            string.IsNullOrWhiteSpace(shipping.Address) ||
            string.IsNullOrWhiteSpace(shipping.City) ||
            string.IsNullOrWhiteSpace(shipping.Phone))
        {
            errorMessage = "Please fill in all shipping fields.";
            return;
        }

        isPlacingOrder = true;

        try
        {
            var order = new CSE325_Team4_GroupProject.Models.Order
            {
                UserId = AuthStateService.CurrentUser?.Id,
                CustomerName = shipping.Name,
                Address = shipping.Address,
                City = shipping.City,
                Phone = shipping.Phone,
                Items = Cart.Items.Select(i => new CSE325_Team4_GroupProject.Models.OrderItem
                {
                    ProductId = i.ProductId,
                    Name = i.Name,
                    Price = i.Price,
                    Quantity = i.Quantity
                }).ToList()
            };

            lastOrderId = await OrderService.CreateOrderAsync(order);
            await Cart.Clear();
            successMessage = $"Order placed successfully! Your order number is #{lastOrderId}.";
            shipping = new();
        }
        catch (Exception)
        {
            errorMessage = "Something went wrong while placing your order. Please try again.";
        }
        finally
        {
            isPlacingOrder = false;
        }
    }

    private class ShippingModel
    {
        public string Name { get; set; } = "";
        public string Address { get; set; } = "";
        public string City { get; set; } = "";
        public string Phone { get; set; } = "";
    }
}
