@page "/manage-products"
@inject CSE325_Team4_GroupProject.Services.ProductService ProductService
@inject CSE325_Team4_GroupProject.Services.AuthStateService AuthStateService
@inject NavigationManager Navigation

<PageTitle>ShopHub - Manage Products</PageTitle>

@if (!isAuthorized)
{
    <div class="empty-cart">
        <p>You must be signed in as a seller to manage products.</p>
        <a class="btn btn-primary" href="/login">Login</a>
    </div>
}
else
{
    <div class="manage-page">
        <h1>Manage Products</h1>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <div class="product-form">
            <h2>@(editingId.HasValue ? $"Edit Product #{editingId}" : "Add New Product")</h2>

            <div class="form-row">
                <div class="form-group">
                    <label for="pName">Name</label>
                    <input id="pName" @bind="form.Name" />
                </div>
                <div class="form-group">
                    <label for="pPrice">Price</label>
                    <input id="pPrice" type="number" step="0.01" min="0" @bind="form.Price" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="pCategory">Category</label>
                    <select id="pCategory" @bind="form.Category">
                        <option value="">-- Select --</option>
                        <option value="Clothing">Clothing</option>
                        <option value="Electronics">Electronics</option>
                        <option value="Furniture">Furniture</option>
                        <option value="Books">Books</option>
                        <option value="Food">Food</option>
                        <option value="Games">Games</option>
                        <option value="Sports">Sports</option>
                        <option value="Beauty">Beauty</option>
                        <option value="Home & Garden">Home & Garden</option>
                        <option value="Automotive">Automotive</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="pSeller">Seller</label>
                    <input id="pSeller" @bind="form.SellerName" />
                </div>
            </div>

            <div class="form-group">
                <label for="pImage">Image URL</label>
                <input id="pImage" @bind="form.ImageUrl" placeholder="https://..." />
            </div>

            <div class="form-group">
                <label for="pDesc">Description</label>
                <textarea id="pDesc" @bind="form.Description" rows="3"></textarea>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveProduct" disabled="@isSaving">
                    @(isSaving ? "Saving..." : (editingId.HasValue ? "Save Changes" : "Add Product"))
                </button>
                @if (editingId.HasValue)
                {
                    <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                }
            </div>
        </div>

        <div class="product-list">
            <h2>All Products (@products.Count)</h2>
            @if (!products.Any())
            {
                <p>No products yet.</p>
            }
            else
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in products)
                        {
                            <tr>
                                <td>@product.Name</td>
                                <td>@product.Category</td>
                                <td>₦@product.Price.ToString("0.00")</td>
                                <td class="table-actions">
                                    <button class="btn btn-sm btn-secondary" @onclick="() => StartEdit(product)">Edit</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteProduct(product.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<style>
    .manage-page { padding: 20px 0; }

    .product-form {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
    }

    .product-form h2, .product-list h2 { margin-bottom: 15px; color: #2c3e50; font-size: 20px; }

    .form-row { display: flex; gap: 15px; flex-wrap: wrap; }

    .form-group { flex: 1; min-width: 200px; margin-bottom: 12px; }

    .form-group label { display: block; font-weight: 600; font-size: 14px; margin-bottom: 5px; color: #2c3e50; }

    .form-group input, .form-group select, .form-group textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 14px;
        box-sizing: border-box;
    }

    .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
        border-color: #3498db;
        outline: none;
        box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
    }

    .form-actions { display: flex; gap: 10px; margin-top: 10px; }

    .btn { padding: 10px 18px; text-decoration: none; display: inline-block; border-radius: 5px; border: none; cursor: pointer; }
    .btn-primary { background: #f1c40f; color: #2c3e50; }
    .btn-primary:hover { background: #f39c12; }
    .btn-secondary { background: #2c3e50; color: white; }
    .btn-secondary:hover { background: #1a252f; }
    .btn-danger { background: #e74c3c; color: white; }
    .btn-danger:hover { background: #c0392b; }
    .btn-sm { padding: 6px 12px; font-size: 13px; }
    .btn:disabled { opacity: 0.6; cursor: not-allowed; }

    .table-actions { display: flex; gap: 8px; }

    .alert { padding: 12px 15px; border-radius: 6px; margin-bottom: 15px; font-size: 14px; }
    .alert-danger { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }

    .empty-cart { text-align: center; padding: 40px; background: #f8f9fa; border-radius: 8px; }

    @@media (max-width: 600px) {
        .form-row { flex-direction: column; }
    }
</style>

@code {
    private List<Product> products = new();
    private bool isAuthorized;
    private bool isSaving;
    private int? editingId;
    private string errorMessage = "";
    private string successMessage = "";
    private ProductForm form = new();

    private readonly string[] sellerTypes = { "Seller", "Both" };

    // Only sellers (and buyer+seller accounts) can use this page.
    protected override void OnInitialized()
    {
        isAuthorized = AuthStateService.CurrentUser != null &&
                       sellerTypes.Contains(AuthStateService.CurrentUser.UserType ?? "");
    }

    protected override async Task OnInitializedAsync()
    {
        if (!isAuthorized)
            return;

        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        products = await ProductService.GetAllProductsAsync();
    }

    // Load the selected product into the form so it can be edited.
    private void StartEdit(Product product)
    {
        editingId = product.Id;
        form = new ProductForm
        {
            Name = product.Name ?? "",
            Price = product.Price,
            Category = product.Category ?? "",
            SellerName = product.SellerName ?? "",
            ImageUrl = product.ImageUrl ?? "",
            Description = product.Description ?? ""
        };
        errorMessage = "";
        successMessage = "";
    }

    private void CancelEdit()
    {
        editingId = null;
        form = new ProductForm();
        errorMessage = "";
    }

    // Adds a new product, or updates the one currently being edited.
    private async Task SaveProduct()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(form.Name) || string.IsNullOrWhiteSpace(form.Category))
        {
            errorMessage = "Please provide at least a name and category.";
            return;
        }

        isSaving = true;

        try
        {
            if (editingId.HasValue)
            {
                var updated = await ProductService.UpdateProductAsync(new Product
                {
                    Id = editingId.Value,
                    Name = form.Name,
                    Price = form.Price,
                    Category = form.Category,
                    SellerName = string.IsNullOrWhiteSpace(form.SellerName)
                        ? AuthStateService.CurrentUser?.FirstName
                        : form.SellerName,
                    ImageUrl = form.ImageUrl,
                    Description = form.Description
                });

                successMessage = updated != null ? "Product updated successfully." : "Product not found.";
            }
            else
            {
                await ProductService.CreateProductAsync(new Product
                {
                    Name = form.Name,
                    Price = form.Price,
                    Category = form.Category,
                    SellerName = string.IsNullOrWhiteSpace(form.SellerName)
                        ? AuthStateService.CurrentUser?.FirstName
                        : form.SellerName,
                    ImageUrl = form.ImageUrl,
                    Description = form.Description,
                    Rating = 4.0
                });

                successMessage = "Product added successfully.";
            }

            editingId = null;
            form = new ProductForm();
            await LoadProducts();
        }
        catch (Exception)
        {
            errorMessage = "Something went wrong while saving the product. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    // Deletes a product and refreshes the list.
    private async Task DeleteProduct(int id)
    {
        var success = await ProductService.DeleteProductAsync(id);

        if (success)
        {
            successMessage = "Product deleted.";
            if (editingId == id)
            {
                editingId = null;
                form = new ProductForm();
            }
            await LoadProducts();
        }
        else
        {
            errorMessage = "Could not delete the product. It may no longer exist.";
        }
    }

    private class ProductForm
    {
        public string Name { get; set; } = "";
        public decimal Price { get; set; }
        public string Category { get; set; } = "";
        public string SellerName { get; set; } = "";
        public string ImageUrl { get; set; } = "";
        public string Description { get; set; } = "";
    }
}
