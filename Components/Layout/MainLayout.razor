@inherits LayoutComponentBase
@inject CSE325_Team4_GroupProject.Services.CartService CartService
@inject CSE325_Team4_GroupProject.Services.AuthStateService AuthStateService
@implements IDisposable

<div class="page-container">
    <!-- HEADER -->
    <header class="header">
        <div class="container">
            <div class="header-content">
                <a href="/" class="logo">🛒 ShopHub</a>
                <div class="search-bar">
                    <input type="text" placeholder="Search for products..." />
                    <button>🔍</button>
                </div>
                <div class="nav-links">
                    <a href="/products">Products</a>
                    <a href="/cart">🛒 Cart <span class="cart-count">@CartService.ItemCount</span></a>

                    @if (AuthStateService.CurrentUser != null)
                    {
                        <span class="user-greeting">👋 @AuthStateService.CurrentUser.FirstName</span>
                        @if (IsSellerOrAdmin)
                        {
                            <a href="/seller/products">My Products</a>
                        }
                        <a href="/profile">Profile</a>
                        <a href="#" @onclick="Logout" @onclick:preventDefault="true">Logout</a>
                    }
                    else
                    {
                        <a href="/login">Login</a>
                        <a href="/signup">Sign Up</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="main-content">
        <div class="container">
            @Body
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div>
                    <h4>ShopHub</h4>
                    <p>Buy and sell items easily</p>
                </div>
                <div>
                    <h4>Quick Links</h4>
                    <a href="/products">Products</a>
                    <a href="/about">About</a>
                    <a href="/contact">Contact</a>
                </div>
                <div>
                    <h4>Account</h4>
                    <a href="/login">Login</a>
                    <a href="/signup">Sign Up</a>
                </div>
                <div>
                    <h4>Follow Us</h4>
                    <p>Social media links</p>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; 2026 ShopHub - All rights reserved
            </div>
        </div>
    </footer>
</div>

<style>
    html,
    body {
        margin: 0;
        padding: 0;
        height: 100%;
    }

    .page-container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .header {
        background: #2c3e50;
        color: white;
        padding: 15px 0;
        position: sticky;
        top: 0;
        z-index: 100;
        flex-shrink: 0;
    }

    .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .logo {
        font-size: 24px;
        font-weight: bold;
        color: white;
        text-decoration: none;
    }

    .logo:hover {
        color: #f1c40f;
    }

    .search-bar {
        display: flex;
        flex: 1;
        max-width: 500px;
    }

    .search-bar input {
        flex: 1;
        padding: 10px 15px;
        border: none;
        border-radius: 5px 0 0 5px;
        font-size: 14px;
    }

    .search-bar button {
        padding: 10px 20px;
        background: #f1c40f;
        border: none;
        border-radius: 0 5px 5px 0;
        cursor: pointer;
        font-size: 16px;
    }

    .nav-links {
        display: flex;
        gap: 20px;
        align-items: center;
        flex-wrap: wrap;
    }

    .nav-links a {
        color: white;
        text-decoration: none;
        font-size: 14px;
        transition: color 0.3s;
    }

    .nav-links a:hover {
        color: #f1c40f;
    }

    .user-greeting {
        color: #f1c40f;
        font-weight: bold;
        font-size: 14px;
    }

    .cart-count {
        background: #f1c40f;
        color: #2c3e50;
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 12px;
        margin-left: 6px;
        font-weight: bold;
    }

    .main-content {
        flex: 1;
        padding: 30px 0;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .footer {
        background: #2c3e50;
        color: #ecf0f1;
        padding: 40px 0 20px;
        flex-shrink: 0;
    }

    .footer-content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid #34495e;
    }

    .footer-content h4 {
        margin-bottom: 10px;
        color: white;
        font-size: 16px;
    }

    .footer-content p {
        color: #bdc3c7;
        font-size: 14px;
        margin: 0;
    }

    .footer-content a {
        display: block;
        color: #bdc3c7;
        text-decoration: none;
        margin: 5px 0;
        transition: color 0.3s;
        font-size: 14px;
    }

    .footer-content a:hover {
        color: #f1c40f;
    }

    .footer-bottom {
        text-align: center;
        padding-top: 20px;
        color: #7f8c8d;
        font-size: 14px;
    }
</style>

@code {
    private bool IsSellerOrAdmin =>
        AuthStateService.CurrentUser != null &&
        (AuthStateService.CurrentUser.UserType is "Seller" or "Both" or "Admin");

    protected override void OnInitialized()
    {
        CartService.Changed += OnCartChanged;
        AuthStateService.OnChange += OnAuthStateChanged;
    }

    private async void OnCartChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void OnAuthStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        AuthStateService.Logout();
        NavigationManager?.NavigateTo("/", true);
    }

    public void Dispose()
    {
        CartService.Changed -= OnCartChanged;
        AuthStateService.OnChange -= OnAuthStateChanged;
    }

    [Inject]
    private NavigationManager? NavigationManager { get; set; }
}