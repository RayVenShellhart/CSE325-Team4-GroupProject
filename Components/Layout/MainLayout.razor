@inherits LayoutComponentBase
@inject CSE325_Team4_GroupProject.Services.CartService CartService
@inject CSE325_Team4_GroupProject.Services.AuthStateService AuthStateService
@inject NavigationManager Navigation
@implements IDisposable

<div class="page-container">
    <!-- HEADER -->
    <header class="header">
        <div class="container">
            <div class="header-content">
                <a href="/" class="logo">🛒 ShopHub</a>
                <div class="search-bar">
                    <input
                        type="text"
                        placeholder="Search for products..."
                        value="@searchTerm"
                        @oninput="OnSearchInput"
                        @onkeydown="OnSearchKey" />
                    <button @onclick="DoSearch" title="Search">🔍</button>
                </div>
                <div class="nav-links">
                    <a href="/products">Products</a>
                    <a href="/seller">Sell</a>
                    <a href="/cart">🛒 Cart <span class="cart-count">@CartService.ItemCount</span></a>

                    @if (AuthStateService.CurrentUser != null)
                    {
                        <a class="user-greeting" href="/profile">👋 @AuthStateService.CurrentUser.FirstName</a>
                        <a href="#" @onclick="Logout" @onclick:preventDefault="true">Logout</a>
                    }
                    else
                    {
                        <a href="/login">Login</a>
                        <a href="/signup">Sign Up</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="main-content">
        <div class="container">
            @Body
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div>
                    <h4>ShopHub</h4>
                    <p>Buy and sell items easily</p>
                    <a href="/about">About Us</a>
                    <a href="/contact">Contact</a>
                </div>
                <div>
                    <h4>Quick Links</h4>
                    <a href="/products">All Products</a>
                    <a href="/become-seller">Become a Seller</a>
                    <a href="/seller">Seller Dashboard</a>
                </div>
                <div>
                    <h4>Account</h4>
                    @if (AuthStateService.CurrentUser != null)
                    {
                        <a href="/profile">My Profile</a>
                        <a href="#" @onclick="Logout" @onclick:preventDefault="true">Logout</a>
                    }
                    else
                    {
                        <a href="/login">Login</a>
                        <a href="/signup">Sign Up</a>
                    }
                </div>
                <div>
                    <h4>Legal</h4>
                    <a href="/terms">Terms & Conditions</a>
                    <a href="/privacy">Privacy Policy</a>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; 2026 ShopHub - All rights reserved
            </div>
        </div>
    </footer>
</div>

<style>
    html,
    body {
        margin: 0;
        padding: 0;
        height: 100%;
    }

    .page-container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .header {
        background: #2c3e50;
        color: white;
        padding: 15px 0;
        position: sticky;
        top: 0;
        z-index: 100;
        flex-shrink: 0;
    }

    .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .logo {
        font-size: 24px;
        font-weight: bold;
        color: white;
        text-decoration: none;
    }

    .logo:hover {
        color: #f1c40f;
    }

    .search-bar {
        display: flex;
        flex: 1;
        max-width: 500px;
    }

    .search-bar input {
        flex: 1;
        padding: 10px 15px;
        border: none;
        border-radius: 5px 0 0 5px;
        font-size: 14px;
    }

    .search-bar button {
        padding: 10px 20px;
        background: #f1c40f;
        border: none;
        border-radius: 0 5px 5px 0;
        cursor: pointer;
        font-size: 16px;
        transition: background 0.3s;
    }

    .search-bar button:hover {
        background: #f39c12;
    }

    .nav-links {
        display: flex;
        gap: 20px;
        align-items: center;
        flex-wrap: wrap;
    }

    .nav-links a {
        color: white;
        text-decoration: none;
        font-size: 14px;
        transition: color 0.3s;
    }

    .nav-links a:hover {
        color: #f1c40f;
    }

    .user-greeting {
        color: #f1c40f;
        font-weight: bold;
        font-size: 14px;
    }

    .user-greeting:hover {
        color: #f39c12;
    }

    .cart-count {
        background: #f1c40f;
        color: #2c3e50;
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 12px;
        margin-left: 6px;
        font-weight: bold;
    }

    .main-content {
        flex: 1;
        padding: 30px 0;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .footer {
        background: #2c3e50;
        color: #ecf0f1;
        padding: 40px 0 20px;
        flex-shrink: 0;
    }

    .footer-content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid #34495e;
    }

    .footer-content h4 {
        margin-bottom: 10px;
        color: white;
        font-size: 16px;
    }

    .footer-content p {
        color: #bdc3c7;
        font-size: 14px;
        margin: 0 0 10px;
    }

    .footer-content a {
        display: block;
        color: #bdc3c7;
        text-decoration: none;
        margin: 5px 0;
        transition: color 0.3s;
        font-size: 14px;
    }

    .footer-content a:hover {
        color: #f1c40f;
    }

    .footer-bottom {
        text-align: center;
        padding-top: 20px;
        color: #7f8c8d;
        font-size: 14px;
    }
</style>

@code {
    private string searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        CartService.Changed += OnCartChanged;
        AuthStateService.OnChange += OnAuthStateChanged;
        await CartService.LoadCartAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            DoSearch();
        }
    }

    private void DoSearch()
    {
        var term = searchTerm.Trim();

        if (string.IsNullOrEmpty(term))
        {
            Navigation.NavigateTo("/products");
            return;
        }

        Navigation.NavigateTo($"/products?search={Uri.EscapeDataString(term)}");
    }

    private async void OnCartChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void OnAuthStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        AuthStateService.Logout();
        await CartService.Clear();
        Navigation.NavigateTo("/", true);
    }

    public void Dispose()
    {
        CartService.Changed -= OnCartChanged;
        AuthStateService.OnChange -= OnAuthStateChanged;
    }
}
